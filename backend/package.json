{
  "name": "@pmo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise Strategy, Portfolio, Product, Project & Work Management Platform - API (modular monolith)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed/run.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/jwt": "9.0.3",
    "@fastify/multipart": "9.0.3",
    "@fastify/rate-limit": "10.2.2",
    "bcryptjs": "2.4.3",
    "fast-xml-parser": "5.2.5",
    "fastify": "5.2.1",
    "jose": "6.0.11",
    "pg": "8.13.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "autocannon": "8.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
