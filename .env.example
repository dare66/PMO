# Copy to .env (start.sh does this and fills random secrets). NEVER commit .env.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters
WEB_PORT=8080

# Demo mode loads clearly-labelled SYNTHETIC data. Never enable in production.
SEED_DEMO=true
DEMO_PASSWORD=change-me-Demo1

# Production bootstrap: first administrator (password >= 12 chars, letters + digits)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ORG_CODE=ORG
ORG_NAME=My Organisation

# Set true when served over HTTPS
COOKIE_SECURE=false

# AI: 'local' (rules-based, no data leaves the platform) | 'anthropic' | 'openai_compatible'
AI_PROVIDER=local
AI_EXTERNAL_ALLOWED=false
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
AI_MONTHLY_TOKEN_BUDGET=2000000

# Per-IP API request limit per minute (raise only for load testing)
# API_RATE_LIMIT=600
